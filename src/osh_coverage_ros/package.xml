<?xml version="1.0"?>
<package format="3">
  <name>osh_coverage_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 adapters for OSH100 dynamic coverage planning.</description>
  <maintainer email="research@example.com">OSH Coverage Research</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>osh_coverage_core</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
